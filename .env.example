# LibraAI LMS - Environment Configuration Example

# Backend Server Port
PORT=5000

# Database Connection (PostgreSQL / Supabase)
DATABASE_URL="postgresql://postgres:password@localhost:5432/libra_db"

# JWT Authentication Secrets
JWT_SECRET="your-super-secure-jwt-secret-key-change-in-production"
JWT_EXPIRES_IN="7d"

# Default Administrator Credentials
ADMIN_EMAIL="admin@libra.edu"
ADMIN_INITIAL_PASSWORD="Admin@Secure2026"

# Google Gemini API (Direct Integration)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"

# OpenRouter API (Alternative LLM Provider)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Frontend Application URL (for CORS)
CLIENT_URL="http://localhost:5173"
